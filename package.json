{
  "name": "orbit",
  "private": true,
  "version": "1.0.0",
  "description": "Orbit — a radial application launcher for Windows",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-app-simulated.ps1",
    "verify:input": "powershell -ExecutionPolicy Bypass -File scripts/verify-app.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.35.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
